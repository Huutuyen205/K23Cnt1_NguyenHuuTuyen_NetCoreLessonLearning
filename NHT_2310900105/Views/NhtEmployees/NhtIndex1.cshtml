@model IEnumerable<NHT_2310900105.Models.NhtEmployee>

@{
    ViewData["Title"] = "Employee List";
}

<!-- Bootstrap CDN + CSS nội bộ -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<style>
    body {
        background-color: #f8f9fa;
        padding: 30px;
    }

    .table thead {
        background-color: #0d6efd;
        color: white;
    }

    .btn-action {
        margin-right: 5px;
    }
</style>

<h1 class="text-center mb-4">Employee List</h1>

<div class="mb-3">
    <a asp-action="NhtCreate" class="btn btn-success">+ Create New</a>
</div>

<table class="table table-bordered table-hover">
    <thead class="text-center">
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().NhtEmpName)</th>
            <th>@Html.DisplayNameFor(model => model.First().NhtEmpLevel)</th>
            <th>@Html.DisplayNameFor(model => model.First().NhtEmpStartDate)</th>
            <th>@Html.DisplayNameFor(model => model.First().NhtEmpStatus)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.NhtEmpName)</td>
                <td>@Html.DisplayFor(modelItem => item.NhtEmpLevel)</td>
                <td>@Html.DisplayFor(modelItem => item.NhtEmpStartDate)</td>
                <td>@Html.DisplayFor(modelItem => item.NhtEmpStatus)</td>
                <td class="text-center">
                    <a asp-action="NhtEdit" asp-route-id="@item.NhtEmpId" class="btn btn-sm btn-warning btn-action">Edit</a>
                    <a asp-action="NhtDetails" asp-route-id="@item.NhtEmpId" class="btn btn-sm btn-info text-white btn-action">Details</a>
                    <a asp-action="NhtDelete" asp-route-id="@item.NhtEmpId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>

        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3">Tổng số: @Model.Count()</th>
        </tr>
    </tfoot>
</table>
