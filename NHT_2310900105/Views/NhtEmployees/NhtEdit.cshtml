@model NHT_2310900105.Models.NhtEmployee

@{
    ViewData["Title"] = "Edit";
}

<!-- Bootstrap & CSS tùy chỉnh -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<style>
    body {
        background-color: #f8f9fa;
        padding: 30px;
    }

    .card {
        border-radius: 12px;
        box-shadow: 0 0 10px rgba(0,0,0,0.05);
    }
</style>

<h1 class="text-center mb-4">Edit</h1>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card p-4">
            <h4 class="text-primary">NhtEmployee</h4>
            <form asp-action="NhtEdit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="NhtEmpId" />

                <div class="mb-3">
                    <label asp-for="NhtEmpName" class="form-label"></label>
                    <input asp-for="NhtEmpName" class="form-control" />
                    <span asp-validation-for="NhtEmpName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NhtEmpLevel" class="form-label"></label>
                    <input asp-for="NhtEmpLevel" class="form-control" />
                    <span asp-validation-for="NhtEmpLevel" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NhtEmpStartDate" class="form-label"></label>
                    <input asp-for="NhtEmpStartDate" class="form-control" />
                    <span asp-validation-for="NhtEmpStartDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NhtEmpStatus" class="form-label"></label>
                    <input asp-for="NhtEmpStatus" class="form-control" />
                    <span asp-validation-for="NhtEmpStatus" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="NhtIndex1" class="btn btn-secondary ms-2">Back to List</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
