@model NhtLesson10.Models.Category

@{
    ViewData["Title"] = "Delete";
}

<style>
    .status-true {
        color: green;
        font-weight: bold;
    }

    .status-false {
        color: red;
        font-weight: bold;
    }

    .btn-delete {
        background-color: #dc3545;
        color: white;
        padding: 8px 16px;
        border: none;
        border-radius: 5px;
    }

    .btn-back {
        color: #007bff;
        text-decoration: none;
        margin-left: 10px;
    }

    .btn-delete:hover {
        background-color: #c82333;
    }

    .btn-back:hover {
        text-decoration: underline;
    }
</style>

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<hr />
<dl class="row">
    <dt class="col-sm-2">Category Name</dt>
    <dd class="col-sm-10">@Model.CateName</dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">
        <span class="@(Model.CateStatus == true ? "status-true" : "status-false")">
            @(Model.CateStatus == true ? "Active" : "Inactive")
        </span>
    </dd>
</dl>

<form asp-action="NhtDelete">
    <input type="hidden" asp-for="CateId" />
    <input type="submit" value="Delete" class="btn-delete" />
    <a asp-action="NhtIndex1" class="btn-back">Back to List</a>
</form>
