@model NhtLesson10.Models.Category

@{
    ViewData["Title"] = "Edit";
}

<style>
    .form-control {
        padding: 8px;
        margin-bottom: 10px;
        width: 100%;
    }

    .btn-save {
        background-color: #007bff;
        color: white;
        padding: 8px 16px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

        .btn-save:hover {
            background-color: #0056b3;
        }

    .btn-back {
        margin-top: 10px;
        display: inline-block;
        color: #007bff;
        text-decoration: none;
    }

        .btn-back:hover {
            text-decoration: underline;
        }
</style>

<h1>Edit</h1>

<h4>Category</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="NhtEdit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CateId" />

            <div class="form-group">
                <label asp-for="CateName" class="control-label"></label>
                <input asp-for="CateName" class="form-control" />
                <span asp-validation-for="CateName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CateStatus" class="control-label"></label>
                <select asp-for="CateStatus" class="form-control">
                    <option value="true" selected="@(Model.CateStatus == true)">True (Active)</option>
                    <option value="false" selected="@(Model.CateStatus == false)">False (Inactive)</option>
                </select>
                <span asp-validation-for="CateStatus" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn-save" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="NhtIndex1" class="btn-back">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
