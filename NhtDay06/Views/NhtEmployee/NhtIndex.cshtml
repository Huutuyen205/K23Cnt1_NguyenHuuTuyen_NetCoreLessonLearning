@{
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Danh sách thành viên</h2>
        <a asp-action="NhtCreate" class="btn btn-primary">➕ Thêm mới</a>
    </div>

    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>BirthDay</th>
                <th>Phone</th>
                <th>Salary</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in ViewBag.nhtEmployee)
            {
                <tr>
                    <td>@m.NhtId</td>
                    <td>@m.NhtName</td>
                    <td>@m.NhtBirthDay.ToString("dd/MM/yyyy")</td>
                    <td>@m.NhtPhone</td>
                    <td>@m.NhtSalary</td>
                    <td class="@(m.NhtStatus == 1 ? "text-success" : "text-danger")">
                        @(m.NhtStatus == 1 ? "Đi làm" : "Nghỉ")
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>